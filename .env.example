# ==============================
# Auth / JWT
# ==============================
APP_JWT_SECRET=replace-with-64+char-random-secret
APP_JWT_EXP_MINUTES=60
APP_OTP_EXP_MINUTES=5
APP_OTP_RESEND_SECONDS=60
APP_MAIL_FROM=no-reply@sportpro.local
APP_FORGOT_PASSWORD_TOKEN_EXP_MINUTES=10
APP_FORGOT_PASSWORD_MAX_ATTEMPTS=5
APP_REFRESH_TOKEN_EXP_DAYS=7
APP_REFRESH_TOKEN_COOKIE_NAME=refresh_token
APP_REFRESH_TOKEN_COOKIE_SECURE=false
APP_REFRESH_TOKEN_COOKIE_SAMESITE=Lax
APP_REFRESH_TOKEN_COOKIE_PATH=/api/auth/refresh-token

# ==============================
# Admin Seed (local/dev only — set APP_ADMIN_SEED_ENABLED=true to create admin on startup)
# ==============================
APP_ADMIN_SEED_ENABLED=false
APP_ADMIN_EMAIL=admin@sportpro.local
APP_ADMIN_PASSWORD=Admin@123456

# ==============================
# SMTP Mail (example: Gmail SMTP)
# ==============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace-with-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ==============================
# Cloudinary Storage
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# PostgreSQL Database
# ==============================
# localhost = chạy API trên máy (IDE/mvnw). Docker Compose ghi đè DB_HOST=database_postgre cho container api.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sport_pro
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ==============================
# VNPay Sandbox
# ==============================
VNPAY_TMN_CODE=your_sandbox_tmn_code
VNPAY_HASH_SECRET=your_sandbox_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=sportpro://payment-result
VNPAY_IPN_URL=https://your-public-host/api/v1/payments/vnpay/ipn
